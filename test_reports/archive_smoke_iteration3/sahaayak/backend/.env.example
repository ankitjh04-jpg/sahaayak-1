# Copy to backend/.env. Never share or commit the .env file.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=sahaayak
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
# Farmer demo is optional. Expert demo bypass is ALWAYS disabled.
DEMO_MODE=true
DEMO_OTP=123456
DEMO_FARMER_PHONE=+919876543210
DEMO_EXPERT_PHONE=+919876543211
STORAGE_ROOT=private_objects
MAX_UPLOAD_BYTES=10485760
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# auto: real Twilio when all keys exist; otherwise SMS unavailable. No fake fallback.
# For explicitly simulated local OTP testing only: OTP_PROVIDER=demo
OTP_PROVIDER=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_BASE_URL=https://verify.twilio.com/v2
# auto: OpenWeather if a key exists, otherwise Open-Meteo (noncommercial demo).
WEATHER_PROVIDER=auto
OPENWEATHER_API_KEY=
OPENWEATHER_URL=https://api.openweathermap.org/data/2.5/weather
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_SECONDS=600
# This key is PUBLIC in browsers. Restrict it to Maps JavaScript API + your website.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID